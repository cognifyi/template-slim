# Local development defaults for apps/api.
# Copy to apps/api/.env.local and adjust for your machine if needed.
# Service names (db, redis) match .devcontainer/docker-compose.yaml;
# use localhost when running the API outside the container.
PORT=3001

DB_HOST=db
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=pass
DB_DATABASE=app

REDIS_HOST=redis
REDIS_PORT=6379

# Local OIDC provider (dex, see .devcontainer/dex/config.yaml).
# The API refuses to boot when OIDC discovery fails — keep dex running
# (`docker compose -f .devcontainer/docker-compose.yaml up -d dex`)
# or point these at your own provider.
OIDC_CLIENT_ID=template-slim
OIDC_ISSUER_BASE_URL=http://localhost:5556/dex
OIDC_AUDIENCE=template-slim

OIDC_MANAGEMENT_API_ENABLED=
OIDC_MANAGEMENT_API_CLIENT_ID=
OIDC_MANAGEMENT_API_CLIENT_SECRET=
OIDC_MANAGEMENT_API_AUDIENCE=

POSTHOG_API_KEY=
POSTHOG_HOST=

ENVIRONMENT=dev

MAINTENANCE_MODE=false

PROXY_DOMAIN=localhost:4000
PROXY_PROTOCOL=http
PROXY_API_KEY=super_secret_key
PROXY_TEMPLATE_URL=http://{{PORT}}.proxy.localhost:4000

AUDIT_TOOLBOX_REQUESTS_ENABLED=false
AUDIT_LOG_RETENTION_DAYS=
AUDIT_CONSOLE_LOG_ENABLED=

SSH_GATEWAY_API_KEY=ssh_secret_api_token
SSH_GATEWAY_COMMAND="ssh -p 2222 {{TOKEN}}@localhost"
SSH_GATEWAY_PUBLIC_KEY=""
SSH_GATEWAY_URL="localhost:2222"

API_KEY_VALIDATION_CACHE_TTL_SECONDS=10
API_KEY_USER_CACHE_TTL_SECONDS=60

ADMIN_API_KEY=supersecret

SKIP_USER_EMAIL_VERIFICATION=true

OTEL_COLLECTOR_API_KEY=otel_collector_api_key

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
ENCRYPTION_SALT=dev-salt-change-me

HEALTH_CHECK_API_KEY=supersecretkey
